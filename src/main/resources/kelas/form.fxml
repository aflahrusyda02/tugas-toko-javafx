<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Pencatatan Produk" />
            <Button onAction="#bukaDaftar" text="Lihat Daftar" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Tambah produk baru" />
                  <Label text="Kode produk" />
                  <TextField fx:id="kodeField" promptText="Contoh: P001" />
                        <Label text="Nama produk" />
                        <TextField fx:id="namaField" promptText="Contoh: Kue Kacang" />
                  <Label text="Kategori" />
                  <RadioButton fx:id="makananRadio" mnemonicParsing="false" text="Makanan" />
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <RadioButton fx:id="minumanRadio" mnemonicParsing="false" text="Minuman" />
                     </children>
                  </HBox>
                        <Label text="Harga" />
                        <TextField fx:id="hargaField" promptText="Contoh: 5000" />
                        <Label styleClass="muted" text="Harga berupa angka bulat tanpa titik/koma dan harus lebih dari 0" wrapText="true" />
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan Produk" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
